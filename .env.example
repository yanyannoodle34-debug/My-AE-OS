# AetherOS API Configuration & Credentials
# Configure these variables in the AI Studio Secrets panel.
# The Secrets Gradle Plugin will automatically inject these into BuildConfig at compile-time.

# Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# NVIDIA Free NIM API Key
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# OpenRouter API Key
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# DeepSeek API Key
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# Facebook Graph API Page Credentials
FACEBOOK_PAGE_NAME=YOUR_FACEBOOK_PAGE_NAME
FACEBOOK_PAGE_ID=YOUR_FACEBOOK_PAGE_ID
FACEBOOK_ACCESS_TOKEN=YOUR_FACEBOOK_ACCESS_TOKEN
